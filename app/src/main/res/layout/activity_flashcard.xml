<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ══ Toolbar ══════════════════════════════════════════════
         ← (back/prev)     [progress]     🔊  Thoát
    ════════════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/on_surface"
        app:title=""
        app:elevation="0dp">

        <!-- Loa (icon, góc phải — trước nút Thoát) -->
        <ImageButton
            android:id="@+id/btnSpeak"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Phát âm"
            android:layout_marginEnd="4dp"
            app:tint="@color/primary"/>

        <!-- Thoát -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Thoát"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"/>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Progress -->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/on_surface_variant"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:paddingHorizontal="16dp"/>

    <!-- ══ MẶT TRƯỚC ════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutFront"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/surface"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp"
        android:layout_marginHorizontal="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:gravity="center"
            android:paddingBottom="12dp"/>

        <TextView
            android:id="@+id/tvPronunciation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/on_surface_variant"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhấn để xem nghĩa"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

    <!-- ══ MẶT SAU ══════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/layoutBack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutBackInner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="24dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvCollocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvRelatedWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <!-- Màn hoàn thành -->
    <TextView
        android:id="@+id/tvFinished"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textSize="22sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"/>

    <!-- Nút "Xem đáp án" -->
    <Button
        android:id="@+id/btnShowAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem đáp án"
        android:backgroundTint="@color/primary"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"/>

    <!-- ══ 4 nút SRS (không còn btnPrev / btnSpeak ở đây) ═══════ -->
    <LinearLayout
        android:id="@+id/layoutSrsButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnAgain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Again"
            android:backgroundTint="@color/srs_again"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnHard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hard"
            android:backgroundTint="@color/srs_hard"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnGood"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Good"
            android:backgroundTint="@color/srs_good"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnEasy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Easy"
            android:backgroundTint="@color/srs_easy"
            android:textColor="@color/white"
            android:textSize="13sp"/>

    </LinearLayout>

</LinearLayout>